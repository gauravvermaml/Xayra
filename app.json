{
  "expo": {
    "name": "Xayra",
    "slug": "silent-confidant",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F12",
    "scheme": "xayra",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Xayra to use on-device speech recognition for faster note transcription.",
        "NSMicrophoneUsageDescription": "Allow Xayra to access your microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0F12"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 52,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.anonymous.silentconfidant",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAppShortcuts",
      ["expo-secure-store", { "configureAndroidBackup": false }],
      "./plugins/withNoSystemBackup",
      "expo-router",
      "expo-local-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Xayra to access your microphone to record voice notes.",
          "enableBackgroundPlayback": false
        }
      ],
      "onnxruntime-react-native",
      "llama.rn",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Xayra to access your microphone.",
          "speechRecognitionPermission": "Allow Xayra to use on-device speech recognition for faster note transcription.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_OAUTH_CLIENT_ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-round.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F12"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E0F12"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "PlusJakartaSans",
                "fontDefinitions": [
                  { "path": "./assets/fonts/plusjakartasans_medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/plusjakartasans_semibold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/plusjakartasans_bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "DMSans",
                "fontDefinitions": [
                  { "path": "./assets/fonts/dmsans_regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/dmsans_medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/dmsans_semibold.ttf", "weight": 600 }
                ]
              }
            ]
          }
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "553e5d3d-2971-4de6-8309-3feb4f6cbe49"
      }
    },
    "owner": "gauravsinghverma"
  }
}
