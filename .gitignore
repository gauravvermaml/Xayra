# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files (bare .env too, not just the *.local variants — this app has no
# runtime need for one, see CLAUDE.md's note on the deleted config/env.ts,
# but nothing should ever land here uncommitted-by-accident either)
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android/*
# ...except the debug signing keystore: Google OAuth client IDs are tied to
# this SHA-1 fingerprint (see services/sync/driveSync.ts), so regenerating it
# via a clean `prebuild` would break Drive sign-in until re-registered in
# Google Cloud Console. Keeping it in the repo makes the debug SHA-1 stable
# across machines and clean rebuilds. (Git can't re-include a file whose
# parent directory is excluded outright, hence excluding /android/* — not
# /android — plus one more level down for /android/app/*.)
!/android/app/
/android/app/*
!/android/app/debug.keystore
# same generated-output exclusion, one level down: local Expo modules
# (modules/*/android/) are source we track, but their own build/ output
# (regenerated by every prebuild, same as the root one above) isn't.
modules/*/android/build/

# local AI model assets — resolved at runtime from the device's document
# directory (see CLAUDE.md), never bundled or committed; these are typically
# dropped at the repo root during local adb-push testing
*.bin
*.gguf
*.onnx

# local build/prebuild logs and UI-dump artifacts from manual dev-loop testing
*.log
ui_dump.xml

# Local wrangler dev-mode state/cache (r2 object put without --remote lands here)
.wrangler/

# Local GGUF models for the desktop eval harness (multi-GB, never committed)
models/
*.gguf
